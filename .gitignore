# Prerequisites
*.d
# ...but changelog.d/ is tracked, not a dependency file
!changelog.d/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*


# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
Build/
build-*/
cmake-*/
**/__pycache__/

# Release directories
dist/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# Captured runner output that the build_runner tests parse; these are inputs, not temporary files.
!scripts/tests/build_runner/fixtures/*.log

# vcpkg
vcpkg_installed/
scripts/toolchain.local.env

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# Jetbrains IDE
.*/

# AI files
CLAUDE.md
AGENTS.md

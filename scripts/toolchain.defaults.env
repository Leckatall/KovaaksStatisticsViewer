# Windows toolchain used by developer and agent builds. See BUILDING.md.
# Values are literal. Variable expansion and inline comments are not supported.
#
# Layers, lowest precedence first:
#   toolchain.defaults.env       this file
#   toolchain.<KSV_TOOLCHAIN>.env the tracked compiler profile: mingw or msvc
#   toolchain.local.env          machine paths shared by both profiles (ignored)
#   toolchain.local.<KSV_TOOLCHAIN>.env machine paths for one profile (ignored)
#   the process environment
# Every `<...>` value is a placeholder that a local file must replace.
# A linked git worktree without its own local files uses the main worktree's.
KSV_TOOLCHAIN=mingw
KSV_CMAKE_EXE=<path to cmake.exe>
KSV_NINJA_EXE=<path to ninja.exe>

# Build runner settings for scripts/build_and_test.py. Not part of the toolchain
# fingerprint, so changing them never wipes build-agent/.
# KSV_BUILD_JOBS: parallel compile jobs (positive integer).
# KSV_BUILD_PRIORITY: Windows priority of everything the runner starts: normal, below_normal or idle.
KSV_BUILD_JOBS=8
KSV_BUILD_PRIORITY=normal

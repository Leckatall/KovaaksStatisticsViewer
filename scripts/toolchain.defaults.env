# Canonical Windows toolchain used by developer and agent builds.
# Values are literal. Variable expansion and inline comments are not supported.
# Override any key in toolchain.local.env or in the process environment.
# A linked git worktree without its own toolchain.local.env uses the main worktree's.
KSV_CMAKE_EXE=C:/Program Files/JetBrains/CLion 2024.1.1/bin/cmake/win/x64/bin/cmake.exe
KSV_NINJA_EXE=C:/Program Files/JetBrains/CLion 2024.1.1/bin/ninja/win/x64/ninja.exe
KSV_C_COMPILER=C:/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/MSVC/14.51.36231/bin/Hostx64/x64/cl.exe
KSV_CXX_COMPILER=C:/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/MSVC/14.51.36231/bin/Hostx64/x64/cl.exe
KSV_VCVARS_BAT=C:/Program Files/Microsoft Visual Studio/18/Community/VC/Auxiliary/Build/vcvars64.bat
KSV_VCPKG_TOOLCHAIN=C:/Users/Lecka/.vcpkg-clion/vcpkg/scripts/buildsystems/vcpkg.cmake
KSV_VCPKG_TRIPLET=x64-windows
KSV_VCPKG_BIN_DIR=C:/Users/Lecka/.vcpkg-clion/vcpkg/installed/x64-windows/bin
KSV_PROTOC_EXE=C:/Users/Lecka/.vcpkg-clion/vcpkg/installed/x64-windows/tools/protobuf/protoc.exe
KSV_QT_BIN_DIR=C:/Qt/6.12.0/msvc2022_64/bin
KSV_QT6_DIR=C:/Qt/6.12.0/msvc2022_64/lib/cmake/Qt6

# Build runner settings for scripts/build_and_test.py. Not part of the toolchain
# fingerprint, so changing them never wipes build-agent/.
# KSV_BUILD_JOBS: parallel compile jobs (positive integer).
# KSV_BUILD_PRIORITY: Windows priority of everything the runner starts: normal, below_normal or idle.
KSV_BUILD_JOBS=8
KSV_BUILD_PRIORITY=normal

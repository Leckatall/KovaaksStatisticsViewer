# MinGW compiler profile, selected by KSV_TOOLCHAIN=mingw. See toolchain.defaults.env.
# Qt's mingw_64 package is release-only, so Debug builds link optimized Qt.
KSV_C_COMPILER=<path to MinGW gcc.exe>
KSV_CXX_COMPILER=<path to MinGW c++.exe>
KSV_VCPKG_TOOLCHAIN=<vcpkg root>/scripts/buildsystems/vcpkg.cmake
KSV_VCPKG_TRIPLET=x64-mingw-dynamic
KSV_VCPKG_BIN_DIR=<vcpkg root>/installed/x64-mingw-dynamic/bin
KSV_PROTOC_EXE=<vcpkg root>/installed/x64-mingw-dynamic/tools/protobuf/protoc.exe
KSV_QT_BIN_DIR=<Qt root>/6.12.0/mingw_64/bin
KSV_QT6_DIR=<Qt root>/6.12.0/mingw_64/lib/cmake/Qt6

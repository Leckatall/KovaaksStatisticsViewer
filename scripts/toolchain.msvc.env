# MSVC compiler profile, selected by KSV_TOOLCHAIN=msvc. See toolchain.defaults.env.
# KSV_VCVARS_BAT is MSVC-only: the runner and the packaging script load INCLUDE, LIB and PATH from it.
KSV_C_COMPILER=<path to cl.exe>
KSV_CXX_COMPILER=<path to cl.exe>
KSV_VCVARS_BAT=<Visual Studio root>/VC/Auxiliary/Build/vcvars64.bat
KSV_VCPKG_TOOLCHAIN=<vcpkg root>/scripts/buildsystems/vcpkg.cmake
KSV_VCPKG_TRIPLET=x64-windows
KSV_VCPKG_BIN_DIR=<vcpkg root>/installed/x64-windows/bin
KSV_PROTOC_EXE=<vcpkg root>/installed/x64-windows/tools/protobuf/protoc.exe
KSV_QT_BIN_DIR=<Qt root>/6.12.0/msvc2022_64/bin
KSV_QT6_DIR=<Qt root>/6.12.0/msvc2022_64/lib/cmake/Qt6
